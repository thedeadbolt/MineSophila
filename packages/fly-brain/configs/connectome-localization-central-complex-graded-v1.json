{
  "format": "fly-brain-connectome-experiment-v1",
  "model": {
    "minimum_synapse_count": 5,
    "settling_steps": 8,
    "time_constant": 2.0,
    "dt": 1.0,
    "activation": "graded",
    "initial_edge_gain": 1.0,
    "train_neuron_bias": false,
    "edge_gain_mode": "cell_type_pair",
    "maximum_edge_gain": 4.0,
    "use_neurotransmitter_signs": true,
    "components": [
      "photoreceptors",
      "lamina_relays",
      "medulla_relays",
      "visual_projection",
      "anterior_visual_inputs",
      "tubercle_bulb",
      "ring_neurons",
      "compass",
      "steering"
    ],
    "readout_components": [
      "visual_projection",
      "compass",
      "steering"
    ],
    "input_transform": "spatial_coverage",
    "readout_normalization": "initial"
  },
  "training": {
    "steps": 3000,
    "batch_size": 16,
    "learning_rate": 0.001,
    "weight_decay": 1e-05,
    "seed": 0,
    "presence_loss_weight": 1.0,
    "direction_loss_weight": 1.0,
    "validation_interval": 100,
    "early_stopping_patience": 8,
    "threshold_search_steps": 181,
    "threshold_search_min": 0.05,
    "threshold_search_max": 0.95
  }
}
