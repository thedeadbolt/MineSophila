    {"name": "a present target has a bearing", "kind": "frame", "base": "valid/frame-tick.json", "expect": "semantic", "patch": [{"op": "set", "path": "/bearing", "value": null}]},
    {"name": "frame target status must follow its pixels", "kind": "frame", "base": "valid/frame-tick.json", "expect": "semantic", "patch": [{"op": "set", "path": "/target/target_status", "value": "fully_visible"}, {"op": "set", "path": "/target/visibility_ratio", "value": 1.0}]},
