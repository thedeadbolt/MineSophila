{
  "description": "Single-record cases. Each patches a valid fixture with JSON Pointer 'set'/'remove' operations. 'valid' must be accepted by every validator; 'schema' must be rejected by the JSON Schemas and by the Java contract parser; 'semantic' passes the schemas but must be rejected by the Java parser and, from M4, the outside validator.",
  "cases": [
    {"name": "sample tolerates unknown members", "kind": "sample", "base": "valid/sample-partially-visible.json", "expect": "valid", "patch": [{"op": "set", "path": "/future_member", "value": {"x": 1}}]},
    {"name": "sample tolerates compatible minor version", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "valid", "patch": [{"op": "set", "path": "/schema_version", "value": "1.7"}]},
    {"name": "sample rejects another major version", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/schema_version", "value": "2.0"}]},
    {"name": "sample requires sample_id", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "remove", "path": "/sample_id"}]},
    {"name": "sample split must be known", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/split", "value": "dev"}]},
    {"name": "sample target_status must be known", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/target/target_status", "value": "visible"}]},
    {"name": "sample pixel counts are non-negative", "kind": "sample", "base": "valid/sample-fully-occluded.json", "expect": "schema", "patch": [{"op": "set", "path": "/target/visible_pixels", "value": -1}]},
    {"name": "sample media type is PNG", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/files/mask/media_type", "value": "image/jpeg"}]},
    {"name": "sample hashes are lowercase SHA-256", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/files/rgb/sha256", "value": "ABC123"}]},
    {"name": "sample paths are relative", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/files/rgb/path", "value": "/rgb/validation/0a/s000000-v00.png"}]},
    {"name": "sample paths cannot escape", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/files/rgb/path", "value": "rgb/validation/../../etc/passwd.png"}]},
    {"name": "sample ratio is at most 1", "kind": "sample", "base": "valid/sample-partially-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/target/visibility_ratio", "value": 1.5}]},
    {"name": "sample viewpoint index is below 99", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/viewpoint_index", "value": 99}]},
    {"name": "sample bounding box has four members", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/target/visible_bbox_xywh", "value": [1, 2, 3]}]},
    {"name": "sample bounding box is null exactly when nothing is visible", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/target/visible_bbox_xywh", "value": null}]},
    {"name": "absent sample has no pixels", "kind": "sample", "base": "valid/sample-absent.json", "expect": "schema", "patch": [{"op": "set", "path": "/target/unoccluded_pixels", "value": 5}]},
    {"name": "absent sample status is absent", "kind": "sample", "base": "valid/sample-absent.json", "expect": "schema", "patch": [{"op": "set", "path": "/target/target_status", "value": "out_of_view"}]},
    {"name": "present sample records distance", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "remove", "path": "/target/distance_blocks"}]},
    {"name": "out-of-view target has no pixels", "kind": "sample", "base": "valid/sample-out-of-view.json", "expect": "schema", "patch": [{"op": "set", "path": "/target/unoccluded_pixels", "value": 10}]},
    {"name": "fully occluded ratio is zero", "kind": "sample", "base": "valid/sample-fully-occluded.json", "expect": "schema", "patch": [{"op": "set", "path": "/target/visibility_ratio", "value": null}]},
    {"name": "capture operation id is not empty", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/capture/operation_id", "value": ""}]},
    {"name": "capture partial tick is within one tick", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "schema", "patch": [{"op": "set", "path": "/capture/partial_tick", "value": 2}]},
    {"name": "status must match counts", "kind": "sample", "base": "valid/sample-partially-visible.json", "expect": "semantic", "patch": [{"op": "set", "path": "/target/target_status", "value": "fully_visible"}, {"op": "set", "path": "/target/visibility_ratio", "value": 1.0}]},
    {"name": "visible cannot exceed unoccluded", "kind": "sample", "base": "valid/sample-partially-visible.json", "expect": "semantic", "patch": [{"op": "set", "path": "/target/unoccluded_pixels", "value": 100}]},
    {"name": "ratio is visible over unoccluded", "kind": "sample", "base": "valid/sample-partially-visible.json", "expect": "semantic", "patch": [{"op": "set", "path": "/target/visibility_ratio", "value": 0.25}]},
    {"name": "bounding box lies inside the mask", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "semantic", "patch": [{"op": "set", "path": "/target/visible_bbox_xywh", "value": [60, 20, 16, 16]}]},
    {"name": "centroid lies inside the bounding box", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "semantic", "patch": [{"op": "set", "path": "/target/visible_centroid_xy", "value": [5.0, 5.0]}]},
    {"name": "sample id matches scene and viewpoint", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "semantic", "patch": [{"op": "set", "path": "/sample_id", "value": "s000000-v05"}]},
    {"name": "image path matches split and shard", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "semantic", "patch": [{"op": "set", "path": "/files/rgb/path", "value": "rgb/validation/ff/s000000-v00.png"}]},
    {"name": "mask and RGB share dimensions", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "semantic", "patch": [{"op": "set", "path": "/files/mask/width", "value": 32}]},
    {"name": "camera basis matches yaw and pitch", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "semantic", "patch": [{"op": "set", "path": "/camera/forward", "value": [0.0, 0.0, 1.0]}]},
    {"name": "eye position is player position plus eye height", "kind": "sample", "base": "valid/sample-fully-visible.json", "expect": "semantic", "patch": [{"op": "set", "path": "/camera/eye_position", "value": [16.5, 67.0, 24.5]}]},

    {"name": "scene tolerates unknown members", "kind": "scene", "base": "valid/scene-present.json", "expect": "valid", "patch": [{"op": "set", "path": "/arena/future_member", "value": true}]},
    {"name": "scene requires layout hash", "kind": "scene", "base": "valid/scene-present.json", "expect": "schema", "patch": [{"op": "remove", "path": "/layout_sha256"}]},
    {"name": "scene difficulty is 1 to 5", "kind": "scene", "base": "valid/scene-present.json", "expect": "schema", "patch": [{"op": "set", "path": "/difficulty", "value": 6}]},
    {"name": "scene id has the s000000 form", "kind": "scene", "base": "valid/scene-present.json", "expect": "schema", "patch": [{"op": "set", "path": "/scene_id", "value": "scene-1"}]},
    {"name": "scene seed algorithm is seed-v1", "kind": "scene", "base": "valid/scene-present.json", "expect": "schema", "patch": [{"op": "set", "path": "/generation/algorithm", "value": "seed-v2"}]},
    {"name": "scene seeds are 53-bit non-negative", "kind": "scene", "base": "valid/scene-present.json", "expect": "schema", "patch": [{"op": "set", "path": "/generation/seeds/layout", "value": -1}]},
    {"name": "present target has a position", "kind": "scene", "base": "valid/scene-present.json", "expect": "schema", "patch": [{"op": "remove", "path": "/target/position"}]},
    {"name": "absent target has no position", "kind": "scene", "base": "valid/scene-absent.json", "expect": "schema", "patch": [{"op": "set", "path": "/target/position", "value": [16, 65, 16]}]},
    {"name": "a source patch has an id", "kind": "scene", "base": "valid/scene-present.json", "expect": "schema", "patch": [{"op": "set", "path": "/source_patch", "value": {"world_seed": 1, "dimension": "minecraft:overworld", "bounds": {"min": [0, 0, 0], "max": [15, 15, 15]}, "generator_version": "minecraft-26.3"}}]},
    {"name": "gamerules are booleans or integers", "kind": "scene", "base": "valid/scene-present.json", "expect": "schema", "patch": [{"op": "set", "path": "/environment/gamerules/advance_time", "value": "no"}]},
    {"name": "scene id matches scene index", "kind": "scene", "base": "valid/scene-present.json", "expect": "semantic", "patch": [{"op": "set", "path": "/generation/scene_index", "value": 5}]},
    {"name": "target lies inside the arena", "kind": "scene", "base": "valid/scene-present.json", "expect": "semantic", "patch": [{"op": "set", "path": "/target/position", "value": [16, 200, 16]}]},
    {"name": "arena bounds are ordered", "kind": "scene", "base": "valid/scene-present.json", "expect": "semantic", "patch": [{"op": "set", "path": "/arena/bounds/min", "value": [40, 64, 0]}]},
    {"name": "target state belongs to the target block", "kind": "scene", "base": "valid/scene-present.json", "expect": "semantic", "patch": [{"op": "set", "path": "/target/block_state", "value": "minecraft:stone"}]},

    {"name": "manifest tolerates unknown members", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "valid", "patch": [{"op": "set", "path": "/software/future_member", "value": "x"}]},
    {"name": "generating manifest is valid", "kind": "dataset", "base": "valid/dataset-generating.json", "expect": "valid", "patch": []},
    {"name": "lifecycle must be known", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "schema", "patch": [{"op": "set", "path": "/lifecycle", "value": "done"}]},
    {"name": "timestamps are UTC with Z", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "schema", "patch": [{"op": "set", "path": "/created_at_utc", "value": "2026-10-23T09:00:00+01:00"}]},
    {"name": "complete manifest needs integrity", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "schema", "patch": [{"op": "remove", "path": "/integrity"}]},
    {"name": "complete manifest needs a passed validation", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "schema", "patch": [{"op": "set", "path": "/integrity/validation/passed", "value": false}]},
    {"name": "generating manifest has no completion time", "kind": "dataset", "base": "valid/dataset-generating.json", "expect": "schema", "patch": [{"op": "set", "path": "/completed_at_utc", "value": "2026-10-23T10:00:00Z"}]},
    {"name": "generating manifest has no final split counts", "kind": "dataset", "base": "valid/dataset-generating.json", "expect": "schema", "patch": [{"op": "set", "path": "/splits/counts", "value": {"train": {"scenes": 0, "samples": 0}, "validation": {"scenes": 0, "samples": 0}, "test": {"scenes": 0, "samples": 0}}}]},
    {"name": "improved transparency is required", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "schema", "patch": [{"op": "set", "path": "/render_environment/improved_transparency", "value": false}]},
    {"name": "storage layout is fixed", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "schema", "patch": [{"op": "set", "path": "/storage/sharding", "value": "none"}]},
    {"name": "software is required", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "schema", "patch": [{"op": "remove", "path": "/software"}]},
    {"name": "a platform base groups splits by scene", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "schema", "patch": [{"op": "set", "path": "/splits/grouping", "value": "source_region"}]},
    {"name": "a natural base groups splits by source region", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "schema", "patch": [{"op": "set", "path": "/generator/scene/base", "value": {"type": "natural_patch", "core_width": 32, "core_length": 32, "height": 128, "context_padding": 192, "scenes_per_patch": 4, "region_separation_blocks": 256}}]},
    {"name": "configuration hash covers the configuration", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/generator/seed", "value": 43}]},
    {"name": "dataset id derives from the configuration hash", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/dataset_id", "value": "honey-l1-fixture-000000000000"}]},
    {"name": "attempted scenes add up", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/counts/attempted_scenes", "value": 9}]},
    {"name": "rejection reasons sum to rejected scenes", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/counts/rejection_reasons/visibility", "value": 3}]},
    {"name": "complete manifest reaches the requested scenes", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/counts/accepted_scenes", "value": 3}, {"op": "set", "path": "/counts/rejected_scenes", "value": 2}, {"op": "set", "path": "/counts/rejection_reasons/visibility", "value": 2}]},
    {"name": "split counts sum to accepted counts", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/splits/counts/test/samples", "value": 2}]},
    {"name": "completion follows creation", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/completed_at_utc", "value": "2026-10-22T09:00:00Z"}]}
  ]
}
