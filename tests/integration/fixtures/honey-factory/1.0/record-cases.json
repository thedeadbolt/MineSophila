    {"name": "dataset rejects an unknown kind", "kind": "dataset", "base": "valid/dataset-clips-complete.json", "expect": "schema", "patch": [{"op": "set", "path": "/kind", "value": "audio"}]},
    {"name": "a clip dataset needs its clip settings", "kind": "dataset", "base": "valid/dataset-clips-complete.json", "expect": "semantic", "patch": [{"op": "remove", "path": "/generator/clips"}]},
    {"name": "a still dataset carries no clip settings", "kind": "dataset", "base": "valid/dataset-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/generator/clips", "value": {"frames_per_tick": 3, "clips_per_scene": 2, "attempts_per_clip": 20, "ticks": {"approach": 100, "pass_by": 32, "scan": 32, "occlusion": 32, "detour": 100, "no_honey": 32}, "approach_linger_ticks": 8, "mix": {"approach": 0.25, "pass_by": 0.15, "scan": 0.15, "occlusion": 0.15, "detour": 0.1}, "drift": {"rate": 0.1, "mean_ticks": 6.0, "max_turn_rate": 6.0, "max_forward": 0.5}, "teacher": {"min_visible_pixels": 50, "reacquire_ticks": 60, "reach_distance_blocks": 1.5}, "motor": {"max_turn_rate": 9.0, "max_turn_accel": 1.8, "max_pitch_rate": 6.0, "max_pitch_accel": 1.2}, "codec": {"name": "h264-lossless"}}}]},
    {"name": "a clip dataset counts its clips", "kind": "dataset", "base": "valid/dataset-clips-complete.json", "expect": "semantic", "patch": [{"op": "remove", "path": "/counts/accepted_clips"}]},
    {"name": "clip dataset storage names its codec", "kind": "dataset", "base": "valid/dataset-clips-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/storage/encodings/rgb", "value": "ffv1"}]},
    {"name": "clip dataset masks are lossless", "kind": "dataset", "base": "valid/dataset-clips-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/storage/encodings/mask", "value": "h264-lossy"}]},
    {"name": "clip settings need at least one frame per tick", "kind": "dataset", "base": "valid/dataset-clips-complete.json", "expect": "schema", "patch": [{"op": "set", "path": "/generator/clips/frames_per_tick", "value": 0}]},
    {"name": "clip dataset split counts must add up", "kind": "dataset", "base": "valid/dataset-clips-complete.json", "expect": "semantic", "patch": [{"op": "set", "path": "/splits/counts/train/clips", "value": 5}]},
    {"name": "a clip scene lists one start draw per clip", "kind": "scene", "base": "valid/scene-present.json", "expect": "valid", "patch": [{"op": "set", "path": "/accepted_sample_count", "value": 0}, {"op": "set", "path": "/accepted_clip_count", "value": 2}]},
    {"name": "a clip scene keeps no samples", "kind": "scene", "base": "valid/scene-present.json", "expect": "semantic", "patch": [{"op": "set", "path": "/accepted_clip_count", "value": 2}]},
    {"name": "a clip scene's start draws match its clips", "kind": "scene", "base": "valid/scene-present.json", "expect": "semantic", "patch": [{"op": "set", "path": "/accepted_sample_count", "value": 0}, {"op": "set", "path": "/accepted_clip_count", "value": 3}]},
    {"name": "a later tick names who drove it", "kind": "frame", "base": "valid/frame-tick.json", "expect": "semantic", "patch": [{"op": "set", "path": "/tick_labels/driver", "value": null}]},
    {"name": "the reset frame has no driver", "kind": "frame", "base": "valid/frame-reset.json", "expect": "semantic", "patch": [{"op": "set", "path": "/tick_labels/driver", "value": "teacher"}]},
    {"name": "frame rejects an unknown driver", "kind": "frame", "base": "valid/frame-tick.json", "expect": "schema", "patch": [{"op": "set", "path": "/tick_labels/driver", "value": "autopilot"}]},
    {"name": "frame tick labels need a driver", "kind": "frame", "base": "valid/frame-tick.json", "expect": "schema", "patch": [{"op": "remove", "path": "/tick_labels/driver"}]},
    {"name": "teacher_drift ticks drift", "kind": "frame", "base": "valid/frame-tick.json", "expect": "semantic", "patch": [{"op": "set", "path": "/tick_labels/driver", "value": "teacher_drift"}]},
    {"name": "teacher ticks do not drift", "kind": "frame", "base": "valid/frame-no-honey.json", "expect": "semantic", "patch": [{"op": "set", "path": "/tick_labels/driver", "value": "teacher"}]},
    {"name": "ticks by driver must add up to the tick count", "kind": "clip", "base": "valid/clip-approach.json", "expect": "semantic", "patch": [{"op": "set", "path": "/summary/ticks_by_driver/teacher", "value": 1}]},
    {"name": "scripts drive only scan, pass-by and occlusion clips", "kind": "clip", "base": "valid/clip-approach.json", "expect": "semantic", "patch": [{"op": "set", "path": "/summary/ticks_by_driver/teacher", "value": 0}, {"op": "set", "path": "/summary/ticks_by_driver/script", "value": 2}]},
    {"name": "clip summary needs ticks by driver", "kind": "clip", "base": "valid/clip-approach.json", "expect": "schema", "patch": [{"op": "remove", "path": "/summary/ticks_by_driver"}]},
    {"name": "the reset frame is not guarded", "kind": "frame", "base": "valid/frame-reset.json", "expect": "semantic", "patch": [{"op": "set", "path": "/tick_labels/guarded", "value": true}]},
    {"name": "frame tick labels say whether they were guarded", "kind": "frame", "base": "valid/frame-tick.json", "expect": "schema", "patch": [{"op": "remove", "path": "/tick_labels/guarded"}]},
    {"name": "guarded ticks cannot exceed the tick count", "kind": "clip", "base": "valid/clip-approach.json", "expect": "semantic", "patch": [{"op": "set", "path": "/summary/guarded_ticks", "value": 3}]},
    {"name": "clip summary counts guarded ticks", "kind": "clip", "base": "valid/clip-approach.json", "expect": "schema", "patch": [{"op": "remove", "path": "/summary/guarded_ticks"}]}
  ]
}
