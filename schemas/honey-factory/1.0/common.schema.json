{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thedeadbolt/MineSophila/schemas/honey-factory/1.0/common.schema.json",
  "title": "honey-factory contract 1.x shared definitions",
  "$defs": {
    "schemaVersion": {"type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!(.*/)?\\.\\.?(/|$))(?!.*//)(?!.*/$).+$"
    },
    "namespacedId": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
    "blockState": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+(\\[[a-z0-9_]+=[a-z0-9_]+(,[a-z0-9_]+=[a-z0-9_]+)*\\])?$"},
    "datasetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}-[0-9a-f]{12}$"},
    "sceneId": {"type": "string", "pattern": "^s[0-9]{6}$"},
    "split": {"enum": ["train", "validation", "test"]},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "timestampUtc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "weather": {"enum": ["clear", "rain", "thunder"]},
    "timeOfDayTicks": {"type": "integer", "minimum": 0, "maximum": 23999},
    "captureMode": {"enum": ["PERSPECTIVE_90", "PANORAMA_310"]},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "blockPos": {"type": "array", "items": {"type": "integer"}, "minItems": 3, "maxItems": 3},
    "blockBounds": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {"min": {"$ref": "#/$defs/blockPos"}, "max": {"$ref": "#/$defs/blockPos"}}
    }
  }
}
